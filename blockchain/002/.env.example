# ============================================
# EIP-2612 Permit 离线签名脚本 配置文件
# ============================================
# 使用方式：填写下方变量后运行 node sign-permit.js
# ⚠️ 此文件包含私钥，请勿提交到 Git！

# 签名者私钥（代币持有者的私钥，不带 0x 前缀也可以）
PRIVATE_KEY=

# 已部署的 SimpleTokenWithPermit 合约地址
TOKEN_ADDRESS=0x0F67a425Db6B9eBf3999D9E2d9add97d5b4DE353

# 代币持有者地址（对应 PRIVATE_KEY 的地址）
OWNER_ADDRESS=0xdda27C9D2215948A13250a244d47B8e93A32406a

# 被授权地址（例如 DEX 合约地址）
SPENDER_ADDRESS=0xFc98008091cB4cC692A2035934ce2283577A042b

# 授权额度（单位：代币最小单位 wei，1 代币 = 10^18 wei）
VALUE=100000000000000000000

# 签名过期时间戳（Unix 秒），示例为 2027-01-01 00:00:00 UTC
DEADLINE=1798761600

# 链 ID（Sepolia = 11155111，主网 = 1，Hardhat 本地 = 31337）
CHAIN_ID=11155111

# 代币名称（必须与部署合约时的 _name 参数完全一致！）
TOKEN_NAME=MyToken
